CREATE TABLE `donotsendemail` (
  `id` int(50) NOT NULL,
  `email` varchar(100) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `issues` (
  `id` int(10) NOT NULL,
  `innotas_id` varchar(15) DEFAULT NULL,
  `Project_id` varchar(20) DEFAULT NULL,
  `project_type` varchar(100) NOT NULL,
  `assessment_name` varchar(150) NOT NULL,
  `issue_title` varchar(200) NOT NULL,
  `description` varchar(1000) DEFAULT NULL,
  `severity` varchar(10) DEFAULT NULL,
  `exploitability` varchar(10) DEFAULT NULL,
  `status` varchar(25) DEFAULT NULL,
  `found_on` date DEFAULT NULL,
  `target_date` date DEFAULT NULL,
  `app_support_contact` varchar(100) DEFAULT NULL,
  `manager` varchar(100) DEFAULT NULL,
  `comments` varchar(2000) DEFAULT NULL,
  `recommendation` varchar(1000) DEFAULT NULL,
  `date_created` datetime DEFAULT NULL,
  `date_updated` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  `date_closed` date DEFAULT NULL,
  `reminder_count` int(5) DEFAULT 0,
  `escalation_count` int(5) DEFAULT 0,
  `IS_MC` varchar(5) DEFAULT 'FALSE',
  `Report_available` varchar(5) NOT NULL DEFAULT 'TRUE',
  `IS_internal` varchar(5) NOT NULL DEFAULT 'FALSE',
  `IS_reporting_unit` varchar(255) NOT NULL DEFAULT 'Tech Risk - Governance'
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

